{
  "app": "uv run python app.py",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "tests", "**/__pycache__", ".venv"]
  },
  "context": {
    "enabledSchedules": ["daily"],
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:target-partitions": ["aws"]
  }
}
